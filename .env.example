# Copie para .env (desenvolvimento) e configure as mesmas variáveis no Easypanel (produção).
# Só variáveis com o prefixo PUBLIC_ chegam ao navegador — não coloque segredos aqui.

# Domínio oficial e liberação de indexação (já existiam no projeto).
PUBLIC_SITE_URL=
PUBLIC_ALLOW_INDEXING=false

# --- Formulário de orçamento ---
# App da web do Google Apps Script ligado à Planilha de leads (URL terminada em /exec).
# Passo a passo: docs/APPS-SCRIPT.md. Sem esta URL o formulário avisa e oferece o WhatsApp.
PUBLIC_LEAD_ENDPOINT=

# Mesmo texto do campo TOKEN em docs/apps-script/Codigo.gs. Filtra envios automatizados.
PUBLIC_LEAD_TOKEN=
