---
import '../styles/balcony.css';
---
<section id="diferenciais" class="balcony-story" data-balcony-story aria-labelledby="balcony-title">
  <div class="balcony-screen" data-balcony-screen>
    <video class="balcony-film" data-balcony-film data-src="/media/sacada-scroll-v1.mp4" muted playsinline preload="none" poster="/media/sacada-scroll-poster-v1.jpg" aria-hidden="true" tabindex="-1"></video>
    <div class="balcony-shade" aria-hidden="true"></div>
    <div class="balcony-message" data-balcony-message="0">
      <h2 id="balcony-title">Uma nova forma de <em>viver sua sacada.</em></h2>
      <p class="balcony-instruction" data-balcony-instruction>Envidraçamento de sacadas na Grande São Paulo.</p>
    </div>
    <div class="balcony-message" data-balcony-message="1" aria-hidden="true" inert>
      <p class="balcony-headline">Abra espaço <em>para a sua vista.</em></p>
    </div>
    <div class="balcony-message balcony-message-end" data-balcony-message="2" aria-hidden="true" inert>
      <h3>Sua sacada. <em>Novas possibilidades.</em></h3>
      <p>Envidraçamento de sacadas na Grande São Paulo.</p>
      <a href="#servicos" class="balcony-cta">Conheça nossas soluções <span aria-hidden="true">↗</span></a>
    </div>
    <div class="balcony-progress" aria-hidden="true"><span data-balcony-progress></span></div>
  </div>
</section>
<script src="../scripts/balcony.ts"></script>
