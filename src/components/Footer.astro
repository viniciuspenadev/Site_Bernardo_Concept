---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { site, navigation, napLines, telHref, whatsappLink } from '../data/site';

// Fora da home as âncoras precisam apontar para a home antes do fragmento.
const prefix = Astro.url.pathname === '/' ? '' : '/';
const links = navigation.map(link => ({ ...link, href: `${prefix}${link.href}` }));
const footerMessage = 'Olá! Vim pelo site e gostaria de um orçamento.';
---
<footer class="bg-primary-900 text-primary-100 py-16 border-t border-primary-800">
  <div class="container mx-auto px-4 lg:px-12">
    <div class="grid gap-12 md:grid-cols-3 mb-16">
      <div class="max-w-sm">
        <a href={`${prefix}#inicio`} aria-label="Bernardo Tecnoglass — início" class="text-white inline-block mb-6"><Brand /></a>
        <p class="text-sm leading-relaxed">{site.description}</p>
      </div>

      <nav aria-label="Navegação do rodapé">
        <h2 class="text-white font-serif text-lg mb-5">Explore</h2>
        <ul class="space-y-3 text-sm">{links.map(link => <li><a href={link.href} class="hover:text-white">{link.label}</a></li>)}</ul>
      </nav>

      <div>
        <h2 class="text-white font-serif text-lg mb-5">Atendimento</h2>
        <ul class="space-y-3 text-sm">
          <li>
            <a class="inline-flex items-center gap-2 hover:text-white" href={whatsappLink(footerMessage)} target="_blank" rel="noopener" data-servico="rodape">
              <WhatsAppIcon class="w-4 h-4" />WhatsApp {site.phoneDisplay}
            </a>
          </li>
          <li>
            <a class="inline-flex items-center gap-2 hover:text-white" href={telHref}>
              <Icon name="phone" class="w-4 h-4" />{site.phoneDisplay}
            </a>
          </li>
          {site.email && <li><a class="hover:text-white" href={`mailto:${site.email}`}>{site.email}</a></li>}
          <li>Atendimento na {site.serviceArea}.</li>
          {site.socialLinks.map(link => <li><a class="hover:text-white" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></li>)}
        </ul>

        {/* NAP completo: preencher `nap` em src/data/site.ts com os dados do contrato social. */}
        {napLines.length > 0 && (
          <address class="mt-6 not-italic text-sm leading-relaxed text-primary-200">
            {napLines.map(line => <span class="block">{line}</span>)}
          </address>
        )}
      </div>
    </div>

    <div class="border-t border-primary-800 pt-8 flex flex-col md:flex-row justify-between gap-4 text-xs tracking-wider">
      <p>© {new Date().getFullYear()} {site.name}.</p>
      <a href="https://www.bluedigitalhub.com.br" target="_blank" rel="noopener noreferrer" class="text-white">BlueDigitalHub</a>
    </div>
  </div>
</footer>
