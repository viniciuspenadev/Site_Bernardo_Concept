---
import { ArrowRight, ChevronLeft, ChevronRight, Menu, X, PenTool, Sun, Layers, Sparkles, MessageCircle, Pause, Play, PanelsTopLeft, Fence, BuildingComplex, ArrowUpRight } from '@lucide/astro';
const icons = { arrow: ArrowRight, left: ChevronLeft, right: ChevronRight, menu: Menu, close: X, pen: PenTool, sun: Sun, layers: Layers, sparkles: Sparkles, message: MessageCircle, pause: Pause, play: Play, window: PanelsTopLeft, gate: Fence, building: BuildingComplex, expand: ArrowUpRight };
interface Props { name: keyof typeof icons; class?: string; }
const { name, class: className = 'w-5 h-5' } = Astro.props;
const Symbol = icons[name];
---
<Symbol class={className} aria-hidden="true" stroke-width="1.5" />
