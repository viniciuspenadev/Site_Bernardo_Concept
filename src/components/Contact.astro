---
import { site, telHref, whatsappLink } from '../data/site';
import Icon from './Icon.astro';
import LeadForm from './LeadForm.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';

const directMessage = 'Olá! Vim pelo site e gostaria de um orçamento.';
---
<section id="contato" class="py-24 md:py-32 bg-primary-900 scroll-mt-20">
  <div class="container mx-auto px-4 text-center">
    <p class="text-primary-200 font-bold tracking-[0.2em] text-xs uppercase mb-6">Bernardo Tecnoglass</p>
    <h2 class="text-3xl md:text-5xl font-serif text-white mb-8 leading-tight">Vamos dar forma ao seu projeto.</h2>
    <p class="text-primary-100 text-base mb-6">Atendimento na {site.serviceArea}.</p>
    <p class="text-primary-100 text-lg max-w-xl mx-auto mb-10 font-light">
      Conte o que você precisa: portas, janelas, portões ou uma solução em vidro. Peça o orçamento pelo formulário ou fale direto com a gente.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={whatsappLink(directMessage)}
        target="_blank"
        rel="noopener"
        data-servico="contato"
        class="wa-cta inline-flex items-center justify-center gap-3 px-8 py-4 text-xs font-bold uppercase tracking-widest rounded-full bg-white text-primary-900 hover:bg-primary-100 transition-colors"
      ><WhatsAppIcon class="w-5 h-5 shrink-0" />Falar no WhatsApp</a>
      <a
        href={telHref}
        class="inline-flex items-center justify-center gap-3 px-8 py-4 text-xs font-bold uppercase tracking-widest rounded-full border border-primary-300 text-white hover:bg-white hover:text-primary-900 transition-colors"
      ><Icon name="phone" class="w-5 h-5 shrink-0" />{site.phoneDisplay}</a>
    </div>

    <LeadForm />
  </div>
</section>
