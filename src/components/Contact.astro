---
import { site, contactHref } from '../data/site';
import Icon from './Icon.astro';
const hasContact = Boolean(site.whatsapp || site.email);
---
<section id="contato" class="py-24 md:py-32 bg-primary-900 scroll-mt-20">
  <div class="container mx-auto px-4 text-center">
    <p class="text-primary-200 font-bold tracking-[0.2em] text-xs uppercase mb-6">Bernardo Tecnoglass</p>
    <h2 class="text-3xl md:text-5xl font-serif text-white mb-8 leading-tight">Vamos dar forma ao seu projeto.</h2>
    <p class="text-primary-100 text-base mb-6">Atendimento na {site.serviceArea}.</p>
    <p class="text-primary-100 text-lg max-w-xl mx-auto mb-10 font-light">{hasContact ? 'Conte o que você precisa: portas, janelas, portões ou uma solução em vidro. Fale com a Bernardo Tecnoglass e solicite um orçamento.' : 'Portas, janelas, portões ou uma solução em vidro. Em breve, nossos canais de atendimento estarão disponíveis aqui.'}</p>
    {hasContact ? <a href={contactHref} target={site.whatsapp ? '_blank' : undefined} rel={site.whatsapp ? 'noopener noreferrer' : undefined} class="inline-flex items-center gap-3 px-10 py-5 bg-white text-primary-900 text-xs font-bold uppercase tracking-widest rounded-full hover:bg-primary-100">Solicitar orçamento<Icon name="arrow" /></a> : <a href="#servicos" class="inline-flex items-center gap-3 px-10 py-5 border border-primary-300 text-white text-xs font-bold uppercase tracking-widest rounded-full hover:bg-white hover:text-primary-900">Ver todas as soluções<Icon name="arrow" /></a>}
  </div>
</section>
{hasContact && <a href={contactHref} target={site.whatsapp ? '_blank' : undefined} rel={site.whatsapp ? 'noopener noreferrer' : undefined} aria-label={site.whatsapp ? 'Atendimento Bernardo Tecnoglass no WhatsApp' : 'Enviar e-mail à Bernardo Tecnoglass'} class="fixed bottom-6 right-6 z-40 flex items-center justify-center w-14 h-14 bg-primary-900 text-white rounded-full border border-white/20 shadow-xl hover:scale-105 transition-transform"><Icon name="message" class="w-6 h-6" /></a>}

