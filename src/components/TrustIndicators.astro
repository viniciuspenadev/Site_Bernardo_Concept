---
import { highlights } from '../data/content';
import { socialProof } from '../data/site';
import Icon from './Icon.astro';

// Prova social tem prioridade sobre os destaques de serviço assim que os números
// verificados forem preenchidos em `socialProof` (src/data/site.ts).
const hasSocialProof = socialProof.length > 0;
---
<div class="relative z-30 container mx-auto px-4 lg:px-12 -mt-16 mb-20">
  <div class="bg-white/95 backdrop-blur-xl shadow-2xl shadow-primary-900/10 p-6 lg:p-10 rounded-3xl border border-white/60">
    {hasSocialProof ? (
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 lg:gap-4" aria-label="Prova social Bernardo Tecnoglass">
        {socialProof.map(item => {
          const Wrapper = item.href ? 'a' : 'div';
          return (
            <Wrapper
              {...(item.href ? { href: item.href, target: '_blank', rel: 'noopener noreferrer' } : {})}
              class="flex flex-col lg:flex-row items-center justify-center text-center lg:text-left gap-3 lg:gap-5"
            >
              <div class="w-12 h-12 shrink-0 rounded-full bg-primary-50 flex items-center justify-center text-primary-600"><Icon name={item.icon} /></div>
              <div>
                <p class="text-xl lg:text-2xl font-serif font-semibold text-primary-900 mb-1">{item.value}</p>
                <p class="text-[9px] uppercase font-bold tracking-[0.12em] text-primary-600">{item.label}</p>
              </div>
            </Wrapper>
          );
        })}
      </div>
    ) : (
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-4">
        {highlights.map(item => <div class="flex flex-col lg:flex-row items-center justify-center text-center lg:text-left gap-3 lg:gap-5">
          <div class="w-12 h-12 shrink-0 rounded-full bg-primary-50 flex items-center justify-center text-primary-600"><Icon name={item.icon} /></div>
          <div><p class="text-xl lg:text-2xl font-serif font-semibold text-primary-900 mb-1">{item.title}</p><p class="text-[9px] uppercase font-bold tracking-[0.12em] text-primary-600">{item.label}</p></div>
        </div>)}
      </div>
    )}
  </div>
</div>
