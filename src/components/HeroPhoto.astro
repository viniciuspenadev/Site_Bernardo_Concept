---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { desktop: ImageMetadata; mobile: ImageMetadata; alt: string; eager?: boolean; }
const { desktop, mobile, alt, eager = false } = Astro.props;
const desktopWidths = [...new Set([960, 1280, 1920, desktop.width].filter(w => w <= desktop.width))].sort((a,b) => a-b);
const mobileWidths = [...new Set([400, 640, 960, mobile.width].filter(w => w <= mobile.width))].sort((a,b) => a-b);
const desktopImages = await Promise.all(desktopWidths.map(width => getImage({src:desktop, width, format:'webp', quality:85})));
const mobileImages = await Promise.all(mobileWidths.map(width => getImage({src:mobile, width, format:'webp', quality:85})));
const fallback = await getImage({src:desktop, width:Math.min(1920,desktop.width), format:'jpg', quality:85});
---
<picture class="hero-background-picture">
  <source media="(max-width: 767px)" type="image/webp" srcset={mobileImages.map((image,index) => `${image.src} ${mobileWidths[index]}w`).join(', ')} sizes="100vw" />
  <source type="image/webp" srcset={desktopImages.map((image,index) => `${image.src} ${desktopWidths[index]}w`).join(', ')} sizes="100vw" />
  <img src={fallback.src} width={desktop.width} height={desktop.height} alt={alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" class="hero-image" />
</picture>
