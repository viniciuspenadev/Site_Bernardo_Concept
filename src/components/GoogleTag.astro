---
// Tag do Google (gtag.js) — primeiro elemento do <head> de todas as páginas.
// O snippet é emitido no formato canônico, sem empacotamento, para que o
// Google Tag Assistant o reconheça e `gtag` fique disponível globalmente.
import { googleAds } from '../data/tracking';

const snippet = `
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '${googleAds.id}');
  // GA4: criar a propriedade, copiar o ID de medição e descomentar a linha abaixo.
  // gtag('config', 'G-XXXXXXXXXX');
`;
---
<!-- Google tag (gtag.js) -->
<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleAds.id}`}></script>
<script is:inline set:html={snippet}></script>
