---
import { projects, categories } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
import Icon from './Icon.astro';
---
<section id="projetos" class="pb-20 pt-10 bg-secondary-50 scroll-mt-28">
  <div class="container mx-auto px-4 lg:px-12">
    <div class="flex flex-col 2xl:flex-row 2xl:items-end justify-between mb-12 gap-8">
      <div class="max-w-xl"><div class="w-12 h-1 bg-primary-500 mb-6 rounded-full"></div><p class="text-primary-600 font-bold tracking-[0.2em] text-xs uppercase mb-3">Projetos e inspirações</p><h2 class="text-4xl md:text-5xl font-serif text-primary-900 leading-tight">Projetos em vidro,<br /><span class="italic text-secondary-500">esquadrias e portões.</span></h2></div>
      <div role="group" aria-label="Filtrar projetos" class="bg-white p-1.5 rounded-full shadow-soft inline-flex self-start flex-nowrap gap-1 max-w-full overflow-x-auto hide-scrollbar">
        {categories.map((category, index) => <button type="button" data-filter={category} aria-pressed={index === 0} aria-controls="projects-scroll" class="filter-button px-4 md:px-6 py-3 rounded-full text-[10px] font-bold uppercase tracking-widest transition-colors whitespace-nowrap shrink-0">{category}</button>)}
      </div>
    </div>
    <div data-carousel class="relative group/carousel">
      <div id="projects-scroll" role="region" aria-label="Carrossel de projetos" tabindex="0" class="flex gap-4 md:gap-8 overflow-x-auto pb-8 snap-x snap-mandatory hide-scrollbar">
        {projects.map(project => <div data-project data-category={project.category} class="project-slide flex-none basis-[280px] sm:basis-[320px] md:basis-[400px] snap-start"><ProjectCard project={project} /></div>)}
      </div>
      <div class="flex items-center justify-between gap-4 mt-4">
        <p class="text-secondary-500 text-xs">Vidros, esquadrias e portões.</p>
        <div class="flex gap-2">
          <button type="button" data-project-prev aria-label="Projetos anteriores" class="gallery-button"><Icon name="left" /></button>
          <button type="button" data-project-next aria-label="Próximos projetos" class="gallery-button"><Icon name="right" /></button>
          <button type="button" data-project-pause aria-label="Pausar carrossel" aria-pressed="false" class="gallery-button"><span data-pause-icon><Icon name="pause" /></span><span data-play-icon hidden><Icon name="play" /></span></button>
        </div>
      </div>
      <p data-project-status role="status" class="sr-only">{projects.length} projetos</p>
      <p data-project-empty hidden class="text-center py-12 text-secondary-500">Nenhum projeto encontrado nesta categoria.</p>
    </div>
  </div>
</section>
<script src="../scripts/portfolio.ts"></script>



