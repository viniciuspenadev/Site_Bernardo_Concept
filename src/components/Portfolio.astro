---
import { projects, categories, categoriaId } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
import CarrosselContinuo from './CarrosselContinuo.astro';
---
<section id="projetos" class="pb-20 pt-10 bg-secondary-50 scroll-mt-28">
  <div class="container mx-auto px-4 lg:px-12">
    <div class="flex flex-col 2xl:flex-row 2xl:items-end justify-between mb-12 gap-8">
      <div class="max-w-xl"><div class="w-12 h-1 bg-primary-500 mb-6 rounded-full"></div><p class="text-primary-600 font-bold tracking-[0.2em] text-xs uppercase mb-3">Nossos projetos</p><h2 class="text-4xl md:text-5xl font-serif text-primary-900 leading-tight">Projetos em vidro,<br /><span class="italic text-secondary-500">esquadrias e portões.</span></h2></div>
      <div role="group" aria-label="Filtrar projetos" class="bg-white p-1.5 rounded-full shadow-soft inline-flex self-start flex-nowrap gap-1 max-w-full overflow-x-auto hide-scrollbar">
        {categories.map((category, index) => <button type="button" data-carrossel-filtro={index === 0 ? '' : categoriaId(category)} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls="projects-scroll" class="filter-button px-4 md:px-6 py-3 rounded-full text-[10px] font-bold uppercase tracking-widest transition-colors whitespace-nowrap shrink-0">{category}</button>)}
      </div>
    </div>
  </div>
  <!-- Fora do container: o carrossel ocupa a largura toda e some nas bordas da tela. -->
  <CarrosselContinuo id="projects-scroll" label="Carrossel de projetos" itemSingular="projeto" itemPlural="projetos">
    {projects.map(project => <div data-carrossel-slide data-filtros={categoriaId(project.category)} class="project-slide flex-none basis-[280px] sm:basis-[320px] md:basis-[400px]"><ProjectCard project={project} /></div>)}
  </CarrosselContinuo>
</section>
