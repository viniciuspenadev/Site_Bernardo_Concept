---
import Icon from '../Icon.astro';
import WhatsAppIcon from '../WhatsAppIcon.astro';
import { whatsappLink } from '../../data/site';
import {
  assistenteNecessidades, assistenteDetalhes, assistenteLocal, sacadasMensagens,
} from '../../data/sacadas';

// Orçamento guiado em três perguntas. Todos os passos já vêm no HTML; o script
// (quote-wizard.ts) só alterna qual está visível e monta a mensagem final.
// O link do resumo é um wa.me comum: o listener global de ConversionEvents registra
// a conversão, com data-servico="sacadas-guiado".
---
<div class="lp-wizard" id="orcamento-guiado">
  <div class="lp-wizard-head">
    <p class="lp-wizard-kicker">Orçamento guiado</p>
    <p class="lp-wizard-count" data-wizard-count data-js-only aria-hidden="true">1/3</p>
  </div>
  <div data-js-only>
    <h2 class="lp-wizard-title">Seu orçamento em 3 passos</h2>
    <p class="lp-wizard-sub">Leva menos de 1 minuto. Você confere tudo antes de enviar.</p>
  </div>

  <div data-wizard>
    <div class="lp-wizard-progress" aria-hidden="true"><span data-wizard-bar></span></div>
    <p class="sr-only" aria-live="polite" data-wizard-live></p>

    <div class="lp-wizard-body">
      <!-- Passo 1: necessidade -->
      <div class="lp-wstep" data-step="1" role="group" aria-labelledby="wiz-q1">
        <p id="wiz-q1" class="lp-wizard-question" tabindex="-1">O que você precisa?</p>
        {assistenteNecessidades.map(item => (
          <button type="button" class="lp-option" data-need={item.id} aria-pressed="false">
            <span class="lp-option-icon"><Icon name={item.icone} class="w-5 h-5" /></span>
            <span><strong>{item.titulo}</strong><small>{item.detalhe}</small></span>
            <Icon name="right" class="lp-option-arrow w-5 h-5" />
          </button>
        ))}
      </div>

      <!-- Passo 2: uma pergunta para cada necessidade -->
      {assistenteNecessidades.map(item => {
        const detalhe = assistenteDetalhes[item.id];
        return (
          <div class="lp-wstep" data-step="2" data-for={item.id} role="group" aria-labelledby={`wiz-q2-${item.id}`} hidden>
            <p id={`wiz-q2-${item.id}`} class="lp-wizard-question" tabindex="-1">{detalhe.pergunta}</p>
            <div class="lp-chips">
              {detalhe.opcoes.map(opcao => <button type="button" class="lp-chip" data-detail={opcao} aria-pressed="false">{opcao}</button>)}
            </div>
            {detalhe.dica && <p class="lp-wizard-hint">{detalhe.dica}</p>}
            <div class="lp-wizard-nav">
              <button type="button" class="lp-wizard-back" data-back><Icon name="left" class="w-4 h-4" />Voltar</button>
            </div>
          </div>
        );
      })}

      <!-- Passo 3: local. Um form para o Enter do teclado avançar. -->
      <form class="lp-wstep" data-step="3" data-local-form novalidate hidden>
        <label id="wiz-q3" for="wiz-local" class="lp-wizard-question" tabindex="-1">{assistenteLocal.pergunta}</label>
        <input id="wiz-local" class="lp-input" name="local" type="text" list="wiz-cidades" autocomplete="address-level2" placeholder={assistenteLocal.placeholder} aria-describedby="wiz-local-dica" />
        <datalist id="wiz-cidades">{assistenteLocal.sugestoes.map(cidade => <option value={cidade} />)}</datalist>
        <p id="wiz-local-dica" class="lp-wizard-hint">Ex.: Santo André, Vila Assunção. Ajuda a confirmar a região de atendimento.</p>
        <div class="lp-wizard-nav">
          <button type="button" class="lp-wizard-back" data-back><Icon name="left" class="w-4 h-4" />Voltar</button>
          <button type="submit" class="lp-btn lp-btn-navy lp-btn-sm">Ver resumo<Icon name="arrow" class="w-4 h-4" /></button>
        </div>
      </form>

      <!-- Resumo -->
      <div class="lp-wstep" data-step="4" role="group" aria-labelledby="wiz-q4" hidden>
        <p id="wiz-q4" class="lp-wizard-question" tabindex="-1">Tudo certo! Confira seu pedido:</p>
        <dl class="lp-summary" data-summary></dl>
        <a
          class="lp-btn lp-btn-wa lp-btn-block"
          href={whatsappLink(sacadasMensagens.geral)}
          target="_blank"
          rel="noopener"
          data-servico="sacadas-guiado"
          data-wizard-whatsapp
        ><WhatsAppIcon class="w-5 h-5" />Enviar pelo WhatsApp</a>
        <p class="lp-wizard-note">A conversa abre com essas respostas já escritas.</p>
        <div class="lp-wizard-alt">
          <button type="button" class="lp-link" data-wizard-form>Prefiro deixar meu contato</button>
          <button type="button" class="lp-link-muted" data-restart><Icon name="restart" class="w-4 h-4" />Recomeçar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Sem JavaScript: caminho direto, sem perguntas. -->
  <div class="lp-wizard-fallback">
    <h2 class="lp-wizard-title">Peça seu orçamento</h2>
    <p class="lp-wizard-sub">Fale direto com a equipe pelo WhatsApp ou deixe seus dados no formulário.</p>
    <a class="lp-btn lp-btn-wa lp-btn-block mt-5" href={whatsappLink(sacadasMensagens.geral)} target="_blank" rel="noopener" data-servico="sacadas-guiado">
      <WhatsAppIcon class="w-5 h-5" />Pedir orçamento no WhatsApp
    </a>
    <p class="lp-wizard-note"><a class="lp-link" href="#orcamento">Ou preencha o formulário</a></p>
  </div>
</div>
<script src="../../scripts/quote-wizard.ts"></script>
